{
  "name": "devops-pipeline-challenge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "dev:frontend": "yarn workspace @challenge/frontend dev",
    "dev:backend": "yarn workspace @challenge/backend dev",
    "lint": "yarn workspace @challenge/backend lint && yarn workspace @challenge/lib lint",
    "check": "yarn lint && yarn build"
  }
}
